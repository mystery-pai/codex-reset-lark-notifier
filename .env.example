# Required when a notification needs to be sent.
LARK_WEBHOOK_URL=

# Optional. Required only when your Lark custom bot enables signature verification.
LARK_WEBHOOK_SECRET=

# Optional. Defaults to the public status API.
CODEX_RESETS_API_URL=https://codex-resets.com/api/v1/status

# Optional fallback override. Usually leave this empty.
SOURCE_URL=
STATE_PATH=data/state.json
NOTIFY_ON_FIRST_RUN=false
