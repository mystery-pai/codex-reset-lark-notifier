# Required when a notification needs to be sent.
LARK_WEBHOOK_URL=

# Optional. Required only when your Lark custom bot enables signature verification.
LARK_WEBHOOK_SECRET=

# Optional. If unset, SOURCE_URL is used and the public page is parsed as a fallback.
CODEX_RESETS_API_URL=

# Optional.
SOURCE_URL=https://codex-resets.com/
STATE_PATH=data/state.json
NOTIFY_ON_FIRST_RUN=false
